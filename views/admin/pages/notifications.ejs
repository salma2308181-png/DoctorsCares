        <section class="admin-page-content">
            <div class="section-greeting">
                <div>
                    <h1 class="dash-greeting">Notifications</h1>
                    <p class="dash-subgreeting">Send announcements to platform users.</p>
                </div>
            </div>

            <div class="overview-grid">
                <div class="dash-card">
                    <div class="card-header"><h3><i class="fas fa-paper-plane"></i> Compose Announcement</h3></div>
                    <form action="/admin/announcements" method="post" class="compose-form">
                        <div class="form-field">
                            <label for="audience">Target Audience</label>
                            <select name="audience" id="audience" class="form-input">
                                <option value="all">All Users</option>
                                <option value="doctors">All Doctors</option>
                                <option value="patients">All Patients</option>
                            </select>
                        </div>
                        <div class="form-field">
                            <label for="channel">Channel</label>
                            <select name="channel" id="channel" class="form-input">
                                <option value="in-app">In-App</option>
                                <option value="email">Email</option>
                                <option value="sms">SMS</option>
                            </select>
                        </div>
                        <div class="form-field">
                            <label for="title">Title</label>
                            <input type="text" name="title" id="title" class="form-input" placeholder="Announcement title" required>
                        </div>
                        <div class="form-field">
                            <label for="body">Message</label>
                            <textarea name="body" id="body" class="form-input form-textarea" placeholder="Type your announcement..." required></textarea>
                        </div>
                        <button type="submit" class="btn-primary-dash btn-full"><i class="fas fa-paper-plane"></i> Send Announcement</button>
                    </form>
                </div>
            </div>

            <div class="dash-card">
                <div class="card-header"><h3><i class="fas fa-history"></i> Announcement History</h3></div>
                <div class="table-wrap">
                    <table class="admin-table">
                        <thead><tr><th>Title</th><th>Audience</th><th>Channel</th><th>Date</th><th>Status</th></tr></thead>
                        <tbody>
                            <% if (announcements && announcements.length) { %>
                                <% announcements.forEach(function(a) { %>
                                <tr>
                                    <td><strong><%= a.title %></strong><br><small style="color:var(--text-muted)"><%= a.body %></small></td>
                                    <td><%= a.audience %></td>
                                    <td><span class="type-tag type-<%= a.channel === 'email' ? 'email' : (a.channel === 'sms' ? 'sms' : 'payment') %>"><%= a.channel %></span></td>
                                    <td><%= a.date %></td>
                                    <td><span class="status-badge <%= a.status === 'sent' ? 'status-active' : 'status-flagged' %>"><%= a.status %></span></td>
                                </tr>
                                <% }); %>
                            <% } else { %>
                                <tr><td colspan="5" style="text-align:center;padding:3rem;color:var(--text-muted);">No announcements sent yet.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
