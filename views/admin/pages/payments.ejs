        <section class="admin-page-content">
            <div class="section-greeting">
                <div>
                    <h1 class="dash-greeting">Payments & Finance</h1>
                    <p class="dash-subgreeting">Track transactions, commissions, and manage refunds.</p>
                </div>
            </div>

            <div class="stats-grid">
                <div class="stat-card stat-green"><div class="stat-icon"><i class="fas fa-dollar-sign"></i></div><div class="stat-info"><span class="stat-value"><%= fmtMoney(pay.monthlyRevenue) %></span><span class="stat-label">Total Revenue</span></div></div>
                <div class="stat-card stat-blue"><div class="stat-icon"><i class="fas fa-percent"></i></div><div class="stat-info"><span class="stat-value"><%= fmtMoney(pay.commission) %></span><span class="stat-label">Commission (<%= pay.commissionPercent || 15 %>%)</span></div></div>
                <div class="stat-card stat-amber"><div class="stat-icon"><i class="fas fa-undo"></i></div><div class="stat-info"><span class="stat-value"><%= fmtMoney(pay.pendingRefunds) %></span><span class="stat-label">Pending Refunds</span><span class="stat-change negative"><%= pay.refundCount || 0 %> request<%= (pay.refundCount || 0) === 1 ? '' : 's' %></span></div></div>
                <div class="stat-card stat-purple"><div class="stat-icon"><i class="fas fa-chart-line"></i></div><div class="stat-info"><span class="stat-value"><%= pay.refundCount || 0 %></span><span class="stat-label">Open Refund Requests</span></div></div>
            </div>

            <div class="dash-card">
                <div class="card-header">
                    <h3><i class="fas fa-undo"></i> Pending Refund Requests</h3>
                    <% if (pay.refundCount > 0) { %><span class="card-tag card-tag-warn"><%= pay.refundCount %> Pending</span><% } %>
                </div>
                <div class="table-wrap">
                    <table class="admin-table">
                        <thead><tr><th>Booking ID</th><th>Patient</th><th>Doctor</th><th>Amount</th><th>Reason</th><th>Date</th><th>Actions</th></tr></thead>
                        <tbody>
                            <% if (refunds && refunds.length) { %>
                                <% refunds.forEach(function(r) { %>
                                <tr>
                                    <td><strong>#<%= r.bookingCode %></strong></td>
                                    <td><%= r.patientName %></td>
                                    <td><%= r.doctorName %></td>
                                    <td><strong><%= fmtMoney(r.amount) %></strong></td>
                                    <td><%= r.reason || '—' %></td>
                                    <td><%= r.date %></td>
                                    <td>
                                        <div class="action-btns">
                                            <form action="/admin/payments/<%= r.id %>/approve-refund" method="post" style="display:inline;">
                                                <button type="submit" class="btn-approve"><i class="fas fa-check"></i> Approve</button>
                                            </form>
                                            <form action="/admin/payments/<%= r.id %>/deny-refund" method="post" style="display:inline;">
                                                <button type="submit" class="btn-reject"><i class="fas fa-times"></i> Deny</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                            <% } else { %>
                                <tr><td colspan="7" style="text-align:center;padding:3rem;color:var(--text-muted);">No pending refund requests.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="dash-card">
                <div class="card-header"><h3><i class="fas fa-list-alt"></i> Transaction History</h3></div>
                <div class="table-toolbar">
                    <input type="text" class="table-search" placeholder="Search transaction...">
                </div>
                <div class="table-wrap">
                    <table class="admin-table">
                        <thead><tr><th>TXN ID</th><th>Patient</th><th>Doctor</th><th>Amount</th><th>Commission</th><th>Type</th><th>Date</th><th>Status</th></tr></thead>
                        <tbody>
                            <% if (transactions && transactions.length) { %>
                                <% transactions.forEach(function(t) { %>
                                <tr>
                                    <td>#<%= t.id %></td>
                                    <td><%= t.patientName %></td>
                                    <td><%= t.doctorName %></td>
                                    <td><%= fmtMoney(t.amount) %></td>
                                    <td><%= t.commission ? fmtMoney(t.commission) : '—' %></td>
                                    <td><span class="type-tag type-<%= t.type === 'refund' ? 'refund' : 'payment' %>"><%= t.type %></span></td>
                                    <td><%= t.date %></td>
                                    <td><span class="status-badge <%= txnStatusClass(t.status) %>"><%= t.status %></span></td>
                                </tr>
                                <% }); %>
                            <% } else { %>
                                <tr><td colspan="8" style="text-align:center;padding:3rem;color:var(--text-muted);">No transactions yet.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
