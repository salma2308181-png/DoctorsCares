        <section class="admin-page-content">
            <div class="section-greeting">
                <div>
                    <h1 class="dash-greeting">Appointments Monitor</h1>
                    <p class="dash-subgreeting">View all bookings, detect abuse, and force-cancel when needed.</p>
                </div>
            </div>

            <div class="stats-grid stats-small">
                <div class="stat-card stat-green"><div class="stat-icon"><i class="fas fa-check-circle"></i></div><div class="stat-info"><span class="stat-value"><%= aStats.confirmed || 0 %></span><span class="stat-label">Confirmed</span></div></div>
                <div class="stat-card stat-amber"><div class="stat-icon"><i class="fas fa-clock"></i></div><div class="stat-info"><span class="stat-value"><%= aStats.pending || 0 %></span><span class="stat-label">Pending</span></div></div>
                <div class="stat-card stat-red"><div class="stat-icon"><i class="fas fa-times-circle"></i></div><div class="stat-info"><span class="stat-value"><%= aStats.cancelled || 0 %></span><span class="stat-label">Cancelled</span></div></div>
                <div class="stat-card stat-purple"><div class="stat-icon"><i class="fas fa-flag"></i></div><div class="stat-info"><span class="stat-value"><%= flaggedCount || 0 %></span><span class="stat-label">Flagged</span></div></div>
            </div>

            <% if (flaggedCount > 0) { %>
            <div class="alert-banner alert-danger">
                <i class="fas fa-shield-alt"></i>
                <div><strong><%= flaggedCount %> flagged appointment<%= flaggedCount === 1 ? '' : 's' %></strong> require review.</div>
            </div>
            <% } %>

            <div class="dash-card">
                <div class="table-toolbar">
                    <input type="text" class="table-search" placeholder="Search by patient, doctor, booking ID...">
                </div>
                <div class="table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr><th>ID</th><th>Patient</th><th>Doctor</th><th>Date & Time</th><th>Fee</th><th>Status</th><th>Actions</th></tr>
                        </thead>
                        <tbody>
                            <% if (appointments && appointments.length) { %>
                                <% appointments.forEach(function(a) { %>
                                <tr<%= a.flagged ? ' class="row-flagged"' : '' %>>
                                    <td><strong>#<%= a.code %></strong></td>
                                    <td><%= a.patientName %></td>
                                    <td><%= a.doctorName %></td>
                                    <td><%= a.date %> Â· <%= a.time %></td>
                                    <td><%= fmtMoney(a.fee) %></td>
                                    <td>
                                        <% if (a.flagged) { %><span class="status-badge status-flagged">Flagged</span><% } %>
                                        <span class="status-badge <%= apptStatusClass(a.status) %>"><%= a.status %></span>
                                    </td>
                                    <td>
                                        <% if (a.status !== 'cancelled') { %>
                                        <form action="/admin/appointments/<%= a.id %>/cancel" method="post" style="display:inline-flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
                                            <input type="text" name="reason" placeholder="Cancel reason" style="padding:0.5rem 0.8rem;border:1px solid var(--border);border-radius:0.5rem;font-size:1.2rem;max-width:12rem;">
                                            <button type="submit" class="btn-reject"><i class="fas fa-times-circle"></i> Cancel</button>
                                        </form>
                                        <% } else { %>
                                        <span style="color:var(--text-muted);font-size:1.3rem;">—</span>
                                        <% } %>
                                    </td>
                                </tr>
                                <% }); %>
                            <% } else { %>
                                <tr><td colspan="7" style="text-align:center;padding:3rem;color:var(--text-muted);">No appointments yet.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
